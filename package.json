{
  "name": "dsh-ledger-wealth",
  "version": "1.0.0",
  "description": "本地优先的记账 + 理财持仓二合一 DSH 插件：文字/图片记账、running balance、每日收益严格降级链、月末双节报告（金额物理隔离，纯本地 SQLite）",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dshmarket",
    "ledger",
    "bookkeeping",
    "personal-finance",
    "wealth",
    "fund",
    "sqlite",
    "local-first",
    "记账",
    "理财"
  ],
  "license": "MIT",
  "author": "ainachoneko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainachoneko/dsh-ledger-wealth.git"
  },
  "homepage": "https://github.com/ainachoneko/dsh-ledger-wealth#readme",
  "bugs": {
    "url": "https://github.com/ainachoneko/dsh-ledger-wealth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/icon-180.png",
    "docs/INSTALL.md",
    "docs/INTERFACES.md"
  ],
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node tests/run.mjs",
    "pack": "node scripts/pack.mjs"
  }
}
